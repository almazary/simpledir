# Local Postgres example:
# DATABASE_URL=postgresql://USERNAME@localhost:5432/simpledir
# Neon / production example:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://USERNAME@localhost:5432/simpledir
JWT_SECRET=change-me-to-a-long-random-string
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
EMAIL_FROM=SimpleDir <noreply@mail.simpledir.my.id>
APP_URL=http://localhost:3001
CORS_ORIGIN=*

# Local: MailHog (preferred when set)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Production: Resend (used when SMTP_HOST is unset)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=SimpleDir <onboarding@resend.dev>
